{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoworker.github.io/EchoSkillHub/schemas/skill-manifest.schema.json",
  "title": "EchoSkillHub generated package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "name", "version", "description", "homepage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "pattern": "^(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "license": { "type": "string", "minLength": 1 },
    "compatibility": { "type": "string", "minLength": 1, "maxLength": 500 },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "allowedTools": { "type": "string", "pattern": "^[^,\\t\\r\\n ]+(?: [^,\\t\\r\\n ]+)*$" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["windows", "macos", "linux"] }
    },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "allOf": [
    { "not": { "properties": { "name": { "type": "string", "pattern": "(?:^|-)(?:anthropic|claude)(?:-|$)" } }, "required": ["name"] } },
    { "not": { "properties": { "name": { "type": "string", "pattern": "<[^>]*>" } }, "required": ["name"] } },
    { "not": { "properties": { "description": { "type": "string", "pattern": "<[^>]*>" } }, "required": ["description"] } }
  ]
}
