{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoworker.github.io/EchoSkillHub/schemas/categories-v1.schema.json",
  "title": "EchoSkillHub Categories v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "categories": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "nameZhCN", "description", "order", "skillCount"],
        "properties": {
          "slug": { "type": "string", "pattern": "^(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32 },
          "name": { "type": "string", "minLength": 1 },
          "nameZhCN": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "skillCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
