{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoworker.github.io/EchoSkillHub/schemas/category-taxonomy.schema.json",
  "title": "EchoSkillHub category taxonomy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "nameZhCN", "description", "order"],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": { "type": "string", "minLength": 1 },
          "nameZhCN": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
