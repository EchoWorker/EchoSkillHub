{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoworker.github.io/EchoSkillHub/schemas/registry-v1.schema.json",
  "title": "EchoSkillHub Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "repository", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
    "skills": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/skill" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "category": { "type": "string", "pattern": "^(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32 },
    "tag": { "type": "string", "pattern": "^(?!.*--)[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32 },
    "tags": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" } },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "status": { "enum": ["active", "deprecated", "revoked"] },
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "publishedAt", "sourceCommit", "downloadUrl", "sha256", "size", "status"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "downloadUrl": { "$ref": "#/$defs/downloadUrl" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "name", "description", "category", "tags", "status", "versions"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/slug" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
        "category": { "$ref": "#/$defs/category" },
        "tags": { "$ref": "#/$defs/tags" },
        "latest": { "$ref": "#/$defs/semver" },
        "downloadUrl": { "$ref": "#/$defs/downloadUrl" },
        "status": { "$ref": "#/$defs/status" },
        "statusReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "macos", "linux"] } },
        "license": { "type": "string", "minLength": 1 },
        "compatibility": { "type": "string", "minLength": 1, "maxLength": 500 },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
        "allowedTools": { "type": "string", "pattern": "^[^,\\t\\r\\n ]+(?: [^,\\t\\r\\n ]+)*$" },
        "versions": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/version" } }
      },
      "dependentRequired": { "latest": ["downloadUrl"], "downloadUrl": ["latest"] },
      "allOf": [
        { "not": { "properties": { "name": { "type": "string", "pattern": "(?:^|-)(?:anthropic|claude)(?:-|$)" } }, "required": ["name"] } },
        { "not": { "properties": { "description": { "type": "string", "pattern": "<[^>]*>" } }, "required": ["description"] } }
      ]
    }
  }
}
