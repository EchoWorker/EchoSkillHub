{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EchoSkillHub governance status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "skills": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,63}$": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "status": { "enum": ["active", "deprecated", "revoked"] },
            "statusReason": { "type": "string", "minLength": 1, "maxLength": 500 },
            "latest": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
            "versions": { "type": "object", "additionalProperties": false, "patternProperties": { "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$": { "enum": ["active", "deprecated", "revoked"] } } }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
